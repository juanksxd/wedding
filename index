    <script>
        // ============================================================
        // CONFIGURACIÓN - ¡CAMBIA ESTOS VALORES!
        // ============================================================
        const SHEET_ID =  '1FKuOxs1sShaoTk_q5kiPm8DVjyBoV7RJmGf-U7TA2g4';  // ← PEGA EL ID DE TU HOJA
        const API_KEY = 'AIzaSyCBdT4V_7Zz01zcZTHTBXi1MlRb-Z5mASk';    // ← PEGA TU API KEY

        // ============================================================
        // RANGOS DE CADA PESTAÑA
        // ============================================================
        const RANGOS = {
            invitados: 'Invitados!A:I',
            gastos: 'Gastos!A:H',
            salones: 'Salones!A:H',
            menus: 'Menus!A:D',
            tareas: 'Tareas!A:E',
            proveedores: 'Proveedores!A:G'
        };

        // ============================================================
        // FUNCIONES PARA SHEETS
        // ============================================================
        async function obtenerDatos(rango) {
            const url = 'https://sheets.googleapis.com/v4/spreadsheets/' + SHEET_ID + '/values/' + rango + '?key=' + API_KEY;
            try {
                const response = await fetch(url);
                if (!response.ok) throw new Error('Error HTTP: ' + response.status);
                const data = await response.json();
                return data.values || [];
            } catch (error) {
                console.error('Error obteniendo datos:', error);
                return [];
            }
        }

        async function escribirDatos(rango, valores) {
            const url = 'https://sheets.googleapis.com/v4/spreadsheets/' + SHEET_ID + '/values/' + rango + '?key=' + API_KEY + '&valueInputOption=USER_ENTERED';
            try {
                const response = await fetch(url, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ values: valores })
                });
                if (!response.ok) throw new Error('Error HTTP: ' + response.status);
                return await response.json();
            } catch (error) {
                console.error('Error escribiendo datos:', error);
                alert('Error al guardar en Sheets. Revisa la consola (F12).');
                return null;
            }
        }

        function procesarDatos(filas) {
            if (!filas || filas.length < 2) return [];
            var encabezados = filas[0];
            var datos = [];
            for (var i = 1; i < filas.length; i++) {
                var fila = filas[i];
                var obj = {};
                for (var j = 0; j < encabezados.length; j++) {
                    obj[encabezados[j].trim()] = fila[j] || '';
                }
                datos.push(obj);
            }
            return datos;
        }

        // ============================================================
        // VARIABLES GLOBALES
        // ============================================================
        var invitadosCache = [];
        var gastosCache = [];
        var salonesCache = [];
        var menusCache = [];
        var tareasCache = [];
        var proveedoresCache = [];

        // ============================================================
        // ACTUALIZAR DASHBOARD
        // ============================================================
        async function actualizarDashboard() {
            var invitadosRaw = await obtenerDatos(RANGOS.invitados);
            var gastosRaw = await obtenerDatos(RANGOS.gastos);
            var tareasRaw = await obtenerDatos(RANGOS.tareas);

            invitadosCache = procesarDatos(invitadosRaw);
            gastosCache = procesarDatos(gastosRaw);
            tareasCache = procesarDatos(tareasRaw);

            var totalInv = invitadosCache.length;
            var confirmados = 0;
            for (var i = 0; i < invitadosCache.length; i++) {
                if (invitadosCache[i].Confirmado && invitadosCache[i].Confirmado.toLowerCase() === 'sí') {
                    confirmados++;
                }
            }
            var totalGasto = 0;
            for (var j = 0; j < gastosCache.length; j++) {
                totalGasto = totalGasto + (parseFloat(gastosCache[j].Importe) || 0);
            }
            var presupuesto = 10000;
            var porcentaje = Math.round((totalGasto / presupuesto) * 100);
            var restante = presupuesto - totalGasto;
            var tareasPend = 0;
            for (var k = 0; k < tareasCache.length; k++) {
                if (tareasCache[k].Completada && tareasCache[k].Completada.toLowerCase() !== 'sí') {
                    tareasPend++;
                }
            }

            document.getElementById('totalInvitados').textContent = totalInv;
            document.getElementById('confirmadosInvitados').textContent = confirmados;
            document.getElementById('gastoTotal').textContent = '$' + totalGasto.toLocaleString();
            document.getElementById('porcentajeUsado').textContent = porcentaje + '%';
            document.getElementById('restantePresupuesto').textContent = '$' + restante.toLocaleString();
            document.getElementById('tareasPendientes').textContent = tareasPend;
            document.getElementById('fechaActualizacion').textContent = new Date().toLocaleString();

            document.getElementById('invitadosBadge').textContent = totalInv;
            document.getElementById('gastosBadge').textContent = '$' + totalGasto.toLocaleString();
            document.getElementById('tareasBadge').textContent = tareasPend;

            // Gráfico
            var gastosPorCategoria = {};
            for (var l = 0; l < gastosCache.length; l++) {
                var cat = gastosCache[l].Categoría || 'Otros';
                gastosPorCategoria[cat] = (gastosPorCategoria[cat] || 0) + (parseFloat(gastosCache[l].Importe) || 0);
            }
            var categorias = Object.keys(gastosPorCategoria);
            var maxGasto = 0;
            for (var m = 0; m < categorias.length; m++) {
                if (gastosPorCategoria[categorias[m]] > maxGasto) {
                    maxGasto = gastosPorCategoria[categorias[m]];
                }
            }
            if (maxGasto === 0) maxGasto = 1;
            var graficoHTML = '';
            if (categorias.length === 0) {
                graficoHTML = '<p style="color: var(--text-light);">No hay gastos registrados</p>';
            } else {
                for (var n = 0; n < categorias.length; n++) {
                    var valor = gastosPorCategoria[categorias[n]];
                    var porcentajeCat = Math.round((valor / totalGasto) * 100);
                    var ancho = Math.round((valor / maxGasto) * 100);
                    if (ancho < 5) ancho = 5;
                    graficoHTML += '<div class="chart-bar-item">' +
                        '<span class="bar-label">' + categorias[n] + '</span>' +
                        '<div class="bar-track">' +
                        '<div class="bar-fill" style="width: ' + ancho + '%;">' + porcentajeCat + '%</div>' +
                        '</div>' +
                        '<span class="bar-value">$' + valor.toLocaleString() + '</span>' +
                        '</div>';
                }
            }
            document.getElementById('graficoGastos').innerHTML = graficoHTML;

            // Tareas pendientes
            var tareasPendientesLista = [];
            for (var o = 0; o < tareasCache.length; o++) {
                if (tareasCache[o].Completada && tareasCache[o].Completada.toLowerCase() !== 'sí') {
                    tareasPendientesLista.push(tareasCache[o]);
                }
            }
            tareasPendientesLista = tareasPendientesLista.slice(0, 5);
            var tareasHTML = '';
            if (tareasPendientesLista.length === 0) {
                tareasHTML = '<li style="color: var(--text-light);">Todas las tareas completadas!</li>';
            } else {
                for (var p = 0; p < tareasPendientesLista.length; p++) {
                    var t = tareasPendientesLista[p];
                    var prioridadClass = 'priority-low';
                    if (t.Prioridad && t.Prioridad.toLowerCase() === 'alta') prioridadClass = 'priority-high';
                    else if (t.Prioridad && t.Prioridad.toLowerCase() === 'media') prioridadClass = 'priority-medium';
                    tareasHTML += '<li>' +
                        '<input type="checkbox" onchange="toggleTarea(this, \'' + t.Título + '\')">' +
                        '<span class="task-text">' + (t.Título || 'Sin título') + '</span>' +
                        '<span class="task-date">' + (t.FechaLimite || '') + '</span>' +
                        '<span class="task-priority ' + prioridadClass + '">' + (t.Prioridad || 'Media') + '</span>' +
                        '</li>';
                }
            }
            document.getElementById('listaTareasDashboard').innerHTML = tareasHTML;

            // Últimos invitados
            var ultimosInvitados = invitadosCache.slice(0, 5);
            var invitadosHTML = '';
            if (ultimosInvitados.length === 0) {
                invitadosHTML = '<tr><td colspan="5" style="text-align: center; color: var(--text-light);">No hay invitados registrados</td></tr>';
            } else {
                for (var q = 0; q < ultimosInvitados.length; q++) {
                    var i = ultimosInvitados[q];
                    var confirmado = 'status-pending';
                    var confirmadoText = ' Pendiente';
                    if (i.Confirmado && i.Confirmado.toLowerCase() === 'sí') {
                        confirmado = 'status-confirmed';
                        confirmadoText = ' Confirmado';
                    }
                    invitadosHTML += '<tr>' +
                        '<td><strong>' + (i.Nombre || 'Sin nombre') + '</strong></td>' +
                        '<td>' + (i.Grupo || '-') + '</td>' +
                        '<td>' + (i.Email || '-') + '</td>' +
                        '<td><span class="status-badge ' + confirmado + '">' + confirmadoText + '</span></td>' +
                        '<td>' + (i.Acompañantes || '0') + '</td>' +
                        '</tr>';
                }
            }
            document.getElementById('tablaInvitadosDashboard').innerHTML = invitadosHTML;

            actualizarTablaInvitados();
            actualizarTablaGastos();
            actualizarSalones();
            actualizarMenus();
            actualizarTareas();
            actualizarProveedores();
        }

        // ============================================================
        // ACTUALIZAR TABLA DE INVITADOS
        // ============================================================
        function actualizarTablaInvitados() {
            document.getElementById('totalInvitadosSeccion').textContent = invitadosCache.length;
            
            var grupoFiltro = document.getElementById('filtroGrupo').value;
            var confirmadoFiltro = document.getElementById('filtroConfirmado').value;
            var busqueda = document.getElementById('buscarInvitado').value.toLowerCase();

            var grupos = [];
            for (var i = 0; i < invitadosCache.length; i++) {
                if (invitadosCache[i].Grupo && grupos.indexOf(invitadosCache[i].Grupo) === -1) {
                    grupos.push(invitadosCache[i].Grupo);
                }
            }
            var selectGrupo = document.getElementById('filtroGrupo');
            var currentVal = selectGrupo.value;
            selectGrupo.innerHTML = '<option value="todos">Todos los grupos</option>';
            for (var j = 0; j < grupos.length; j++) {
                selectGrupo.innerHTML += '<option value="' + grupos[j] + '">' + grupos[j] + '</option>';
            }
            selectGrupo.value = currentVal;

            var filtrados = invitadosCache;
            if (grupoFiltro !== 'todos') {
                var temp = [];
                for (var k = 0; k < filtrados.length; k++) {
