<!DOCTYPE html>
<html lang="es" id="html-root">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>💍 Mi Boda - Wedding Planner</title>
    <!-- Font Awesome local (sin CDN) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        /* ===== RESET Y VARIABLES ===== */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --primary: #F5E6E8;
            --primary-dark: #E8D0D4;
            --secondary: #C9A96E;
            --secondary-light: #E8D5A3;
            --text-dark: #2D1B1E;
            --text-light: #6B5B5E;
            --white: #FFFFFF;
            --bg: #FDF8F9;
            --card-bg: #FFFFFF;
            --shadow: 0 4px 20px rgba(201, 169, 110, 0.15);
            --border-color: #F5E6E8;
            --hover-bg: #F5E6E8;
            --radius: 16px;
            --transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        [data-theme="dark"] {
            --primary: #3D2A2E;
            --primary-dark: #4A3539;
            --secondary: #C9A96E;
            --secondary-light: #B8924F;
            --text-dark: #F0E6E8;
            --text-light: #B8A8AC;
            --white: #1E1517;
            --bg: #120C0E;
            --card-bg: #2A1D20;
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
            --border-color: #3D2A2E;
            --hover-bg: #3D2A2E;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text-dark);
            display: flex;
            min-height: 100vh;
            margin: 0;
            transition: var(--transition);
        }

        /* ===== MENÚ LATERAL ===== */
        .sidebar {
            width: 260px;
            background: var(--card-bg);
            box-shadow: 2px 0 20px rgba(0,0,0,0.05);
            padding: 30px 20px;
            display: flex;
            flex-direction: column;
            position: fixed;
            top: 0;
            left: 0;
            height: 100vh;
            z-index: 1000;
            border-right: 2px solid var(--border-color);
            transition: var(--transition);
            overflow-y: auto;
        }
        .sidebar-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.5);
            z-index: 999;
            backdrop-filter: blur(4px);
        }
        .sidebar-overlay.active { display: block; }
        .sidebar-header {
            text-align: center;
            padding-bottom: 30px;
            border-bottom: 2px solid var(--border-color);
            margin-bottom: 30px;
        }
        .sidebar-header h1 {
            font-family: 'Playfair Display', serif;
            font-size: 22px;
            color: var(--text-dark);
            letter-spacing: 1px;
        }
        .sidebar-header .subtitle {
            font-size: 12px;
            color: var(--secondary);
            text-transform: uppercase;
            letter-spacing: 3px;
            margin-top: 5px;
        }
        .sidebar-header .ring-icon {
            font-size: 32px;
            color: var(--secondary);
            display: block;
            margin-bottom: 8px;
        }
        .nav-menu {
            flex: 1;
            list-style: none;
        }
        .nav-menu li { margin-bottom: 6px; }
        .nav-menu a {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 12px 16px;
            border-radius: 12px;
            color: var(--text-light);
            text-decoration: none;
            font-weight: 500;
            font-size: 15px;
            transition: var(--transition);
            cursor: pointer;
        }
        .nav-menu a i {
            width: 22px;
            font-size: 18px;
            color: var(--secondary);
        }
        .nav-menu a:hover {
            background: var(--hover-bg);
            color: var(--text-dark);
            transform: translateX(4px);
        }
        .nav-menu a.active {
            background: var(--secondary);
            color: var(--white);
            box-shadow: 0 4px 12px rgba(201, 169, 110, 0.3);
        }
        .nav-menu a.active i { color: var(--white); }
        .nav-menu .badge {
            margin-left: auto;
            background: var(--secondary);
            color: white;
            font-size: 11px;
            padding: 2px 10px;
            border-radius: 20px;
        }
        .sidebar-footer {
            border-top: 2px solid var(--border-color);
            padding-top: 20px;
            font-size: 12px;
            color: var(--text-light);
            text-align: center;
        }
        .theme-toggle-wrapper {
            margin-top: 10px;
            padding: 12px 16px;
            border-radius: 12px;
            background: var(--hover-bg);
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            transition: var(--transition);
        }
        .theme-toggle-wrapper:hover { background: var(--border-color); }
        .theme-toggle-wrapper span {
            font-size: 14px;
            font-weight: 500;
            color: var(--text-light);
        }
        .toggle-switch {
            width: 48px;
            height: 26px;
            background: var(--text-light);
            border-radius: 30px;
            position: relative;
            transition: var(--transition);
            cursor: pointer;
        }
        .toggle-switch::after {
            content: '';
            width: 20px;
            height: 20px;
            background: var(--white);
            border-radius: 50%;
            position: absolute;
            top: 3px;
            left: 3px;
            transition: var(--transition);
        }
        [data-theme="dark"] .toggle-switch { background: var(--secondary); }
        [data-theme="dark"] .toggle-switch::after { left: 25px; }
        .hamburger {
            display: none;
            position: fixed;
            top: 20px;
            left: 20px;
            z-index: 1001;
            background: var(--card-bg);
            border: 2px solid var(--border-color);
            border-radius: 12px;
            padding: 10px 12px;
            cursor: pointer;
            font-size: 24px;
            color: var(--text-dark);
            transition: var(--transition);
            box-shadow: var(--shadow);
        }
        .hamburger:hover { transform: scale(1.05); }

        /* ===== CONTENIDO PRINCIPAL ===== */
        .main-content {
            margin-left: 260px;
            padding: 40px 50px;
            width: 100%;
            transition: var(--transition);
        }
        .section {
            display: none;
            animation: fadeIn 0.5s ease;
        }
        .section.active { display: block; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ===== TOP BAR ===== */
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 35px;
            flex-wrap: wrap;
            gap: 15px;
        }
        .top-bar h2 {
            font-family: 'Playfair Display', serif;
            font-size: 30px;
            color: var(--text-dark);
        }
        .top-bar .date {
            color: var(--text-light);
            font-size: 14px;
            background: var(--card-bg);
            padding: 8px 18px;
            border-radius: 30px;
            box-shadow: var(--shadow);
            transition: var(--transition);
        }
        .top-bar .date i {
            color: var(--secondary);
            margin-right: 8px;
        }

        /* ===== TARJETAS ===== */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 35px;
        }
        .stat-card {
            background: var(--card-bg);
            padding: 22px 24px;
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            border-left: 5px solid var(--secondary);
            transition: var(--transition);
        }
        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 30px rgba(201, 169, 110, 0.2);
        }
        .stat-card .stat-label {
            font-size: 13px;
            color: var(--text-light);
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 500;
        }
        .stat-card .stat-number {
            font-family: 'Playfair Display', serif;
            font-size: 34px;
            font-weight: 700;
            color: var(--text-dark);
            margin: 6px 0 4px;
        }
        .stat-card .stat-sub {
            font-size: 13px;
            color: var(--secondary);
        }
        .stat-card .stat-icon {
            float: right;
            font-size: 32px;
            color: var(--primary-dark);
            opacity: 0.6;
        }
        .row-two {
            display: grid;
            grid-template-columns: 1.6fr 1fr;
            gap: 25px;
            margin-bottom: 35px;
        }
        .card {
            background: var(--card-bg);
            border-radius: var(--radius);
            padding: 24px 28px;
            box-shadow: var(--shadow);
            transition: var(--transition);
        }
        .card-title {
            font-family: 'Playfair Display', serif;
            font-size: 18px;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--text-dark);
        }
        .card-title i {
            color: var(--secondary);
            font-size: 20px;
        }
        .card-header-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        /* ===== GRÁFICO ===== */
        .chart-bars {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }
        .chart-bar-item {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .chart-bar-item .bar-label {
            width: 80px;
            font-size: 14px;
            font-weight: 500;
            color: var(--text-light);
        }
        .chart-bar-item .bar-track {
            flex: 1;
            height: 28px;
            background: var(--hover-bg);
            border-radius: 20px;
            overflow: hidden;
            position: relative;
        }
        .chart-bar-item .bar-fill {
            height: 100%;
            border-radius: 20px;
            background: linear-gradient(90deg, var(--secondary-light), var(--secondary));
            transition: width 1s ease;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding-right: 10px;
            color: var(--white);
            font-size: 12px;
            font-weight: 600;
        }
        .chart-bar-item .bar-value {
            width: 60px;
            text-align: right;
            font-weight: 600;
            font-size: 14px;
            color: var(--text-dark);
        }

        /* ===== TAREAS ===== */
        .task-list { list-style: none; }
        .task-list li {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid var(--border-color);
        }
        .task-list li:last-child { border-bottom: none; }
        .task-list input[type="checkbox"] {
            width: 20px;
            height: 20px;
            accent-color: var(--secondary);
            cursor: pointer;
        }
        .task-list .task-text {
            flex: 1;
            font-size: 15px;
            color: var(--text-dark);
        }
        .task-list .task-text.done {
            text-decoration: line-through;
            color: var(--text-light);
        }
        .task-list .task-date {
            font-size: 12px;
            color: var(--text-light);
            background: var(--bg);
            padding: 3px 12px;
            border-radius: 20px;
        }
        .task-list .task-priority {
            font-size: 11px;
            padding: 2px 10px;
            border-radius: 20px;
            font-weight: 600;
            white-space: nowrap;
        }
        .priority-high { background: #FEE2E2; color: #991B1B; }
        .priority-medium { background: #FEF3C7; color: #92400E; }
        .priority-low { background: #D1FAE5; color: #065F46; }
        [data-theme="dark"] .priority-high { background: #7F1D1D; color: #FCA5A5; }
        [data-theme="dark"] .priority-medium { background: #78350F; color: #FCD34D; }
        [data-theme="dark"] .priority-low { background: #064E3B; color: #6EE7B7; }

        /* ===== TABLAS ===== */
        .table-wrap { overflow-x: auto; margin-top: 10px; }
        .mini-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 14px;
        }
        .mini-table th {
            text-align: left;
            padding: 10px 12px;
            background: var(--hover-bg);
            color: var(--text-dark);
            font-weight: 600;
        }
        .mini-table td {
            padding: 10px 12px;
            border-bottom: 1px solid var(--border-color);
            color: var(--text-dark);
        }
        .mini-table tr:hover td { background: var(--hover-bg); }
        .status-badge {
            padding: 3px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 600;
            display: inline-block;
        }
        .status-confirmed { background: #D1FAE5; color: #065F46; }
        .status-pending { background: #FEF3C7; color: #92400E; }
        .status-paid { background: #D1FAE5; color: #065F46; }
        .status-unpaid { background: #FEE2E2; color: #991B1B; }
        .status-hired { background: #D1FAE5; color: #065F46; }
        .status-not-hired { background: #FEF3C7; color: #92400E; }
        [data-theme="dark"] .status-confirmed,
        [data-theme="dark"] .status-paid,
        [data-theme="dark"] .status-hired {
            background: #064E3B;
            color: #6EE7B7;
        }
        [data-theme="dark"] .status-pending,
        [data-theme="dark"] .status-unpaid,
        [data-theme="dark"] .status-not-hired {
            background: #78350F;
            color: #FCD34D;
        }
        .btn-icon {
            background: none;
            border: none;
            color: var(--text-light);
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 6px;
            transition: var(--transition);
        }
        .btn-icon:hover {
            background: var(--hover-bg);
            color: var(--text-dark);
        }
        .btn-primary {
            background: var(--secondary);
            color: white;
            border: none;
            padding: 10px 24px;
            border-radius: 30px;
            font-weight: 600;
            font-size: 14px;
            cursor: pointer;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-primary:hover {
            background: #B8924F;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(201, 169, 110, 0.3);
        }
        .btn-secondary {
            background: var(--hover-bg);
            color: var(--text-dark);
            border: 2px solid var(--border-color);
            padding: 8px 20px;
            border-radius: 30px;
            font-weight: 500;
            font-size: 14px;
            cursor: pointer;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-secondary:hover { background: var(--border-color); }

        /* ===== TARJETAS DE SALONES ===== */
        .venues-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 20px;
            margin-top: 15px;
        }
        .venue-card {
            background: var(--card-bg);
            border-radius: var(--radius);
            padding: 20px;
            box-shadow: var(--shadow);
            border-left: 4px solid var(--secondary);
            transition: var(--transition);
        }
        .venue-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 30px rgba(201, 169, 110, 0.2);
        }
        .venue-card h3 {
            font-family: 'Playfair Display', serif;
            font-size: 18px;
            margin-bottom: 8px;
            color: var(--text-dark);
        }
        .venue-card .venue-detail {
            font-size: 14px;
            color: var(--text-light);
            margin: 4px 0;
        }
        .venue-card .venue-detail i {
            width: 20px;
            color: var(--secondary);
            margin-right: 6px;
        }
        .venue-card .venue-price {
            font-size: 20px;
            font-weight: 700;
            color: var(--secondary);
            margin: 10px 0;
        }

        /* ===== MENÚS ===== */
        .menu-cards {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 20px;
            margin-top: 15px;
        }
        .menu-card {
            background: var(--card-bg);
            border-radius: var(--radius);
            padding: 20px;
            box-shadow: var(--shadow);
            text-align: center;
            transition: var(--transition);
            border: 2px solid var(--border-color);
        }
        .menu-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 30px rgba(201, 169, 110, 0.2);
            border-color: var(--secondary);
        }
        .menu-card .menu-icon { font-size: 40px; color: var(--secondary); margin-bottom: 10px; }
        .menu-card h3 {
            font-family: 'Playfair Display', serif;
            font-size: 20px;
            color: var(--text-dark);
        }
        .menu-card .menu-price {
            font-size: 24px;
            font-weight: 700;
            color: var(--secondary);
            margin: 8px 0;
        }
        .menu-card .menu-desc {
            font-size: 14px;
            color: var(--text-light);
            margin: 8px 0;
        }

        /* ===== PROVEEDORES ===== */
        .provider-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
            margin-top: 15px;
        }
        .provider-card {
            background: var(--card-bg);
            border-radius: var(--radius);
            padding: 20px;
            box-shadow: var(--shadow);
            transition: var(--transition);
            border: 2px solid var(--border-color);
        }
        .provider-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 30px rgba(201, 169, 110, 0.2);
        }
        .provider-card h3 {
            font-family: 'Playfair Display', serif;
            font-size: 18px;
            color: var(--text-dark);
            margin-bottom: 8px;
        }
        .provider-card .provider-detail {
            font-size: 14px;
            color: var(--text-light);
            margin: 4px 0;
        }
        .provider-card .provider-detail i {
            width: 20px;
            color: var(--secondary);
            margin-right: 6px;
        }

        /* ===== FILTROS ===== */
        .filter-bar {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }
        .filter-bar select,
        .filter-bar input {
            padding: 8px 16px;
            border-radius: 30px;
            border: 2px solid var(--border-color);
            background: var(--card-bg);
            color: var(--text-dark);
            font-size: 14px;
            transition: var(--transition);
        }
        .filter-bar select:focus,
        .filter-bar input:focus {
            outline: none;
            border-color: var(--secondary);
        }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 1200px) { .main-content { padding: 30px 30px; } }
        @media (max-width: 992px) {
            .row-two { grid-template-columns: 1fr; }
            .venues-grid { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
        }
        @media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
                width: 280px;
                box-shadow: 4px 0 30px rgba(0,0,0,0.2);
            }
            .sidebar.open { transform: translateX(0); }
            .hamburger { display: block; }
            .main-content {
                margin-left: 0;
                padding: 20px 16px;
                padding-top: 80px;
            }
            .top-bar h2 { font-size: 24px; }
            .top-bar .date { font-size: 12px; padding: 6px 14px; }
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
            }
            .stat-card { padding: 16px 18px; }
            .stat-card .stat-number { font-size: 26px; }
            .stat-card .stat-icon { font-size: 24px; }
            .card { padding: 18px 16px; }
            .chart-bar-item .bar-label { width: 60px; font-size: 12px; }
            .chart-bar-item .bar-value { width: 50px; font-size: 12px; }
            .mini-table { font-size: 12px; }
            .mini-table th, .mini-table td { padding: 8px 10px; }
            .task-list .task-text { font-size: 14px; }
            .card-header-actions { flex-direction: column; align-items: stretch; }
            .venues-grid, .menu-cards, .provider-grid { grid-template-columns: 1fr; }
        }
        @media (max-width: 480px) {
            .stats-grid { grid-template-columns: 1fr; }
            .top-bar h2 { font-size: 20px; }
            .main-content { padding: 16px 12px; padding-top: 75px; }
            .stat-card .stat-number { font-size: 22px; }
            .hamburger { top: 12px; left: 12px; padding: 8px 10px; font-size: 20px; }
        }
        .mt-20 { margin-top: 20px; }
        .text-center { text-align: center; }
    </style>
</head>
<body>

    <!-- ===== OVERLAY Y MENÚ ===== -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>
    <button class="hamburger" id="hamburgerBtn"><i class="fas fa-bars"></i></button>

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <span class="ring-icon">💍</span>
            <h1>Mi Boda</h1>
            <div class="subtitle">Wedding Planner</div>
        </div>
        <ul class="nav-menu">
            <li><a class="active" data-section="dashboard"><i class="fas fa-chart-pie"></i> <span>Dashboard</span></a></li>
            <li><a data-section="invitados"><i class="fas fa-users"></i> <span>Invitados</span> <span class="badge" id="invitadosBadge">0</span></a></li>
            <li><a data-section="gastos"><i class="fas fa-coins"></i> <span>Gastos</span> <span class="badge" id="gastosBadge">$0</span></a></li>
            <li><a data-section="salones"><i class="fas fa-building"></i> <span>Salones</span></a></li>
            <li><a data-section="menus"><i class="fas fa-utensils"></i> <span>Menús</span></a></li>
            <li><a data-section="tareas"><i class="fas fa-check-circle"></i> <span>Tareas</span> <span class="badge" id="tareasBadge">0</span></a></li>
            <li><a data-section="proveedores"><i class="fas fa-truck"></i> <span>Proveedores</span></a></li>
            <li>
                <div class="theme-toggle-wrapper" id="themeToggle">
                    <span><i class="fas fa-moon"></i> Modo oscuro</span>
                    <div class="toggle-switch"></div>
                </div>
            </li>
        </ul>
        <div class="sidebar-footer">
            <i class="fas fa-heart" style="color: var(--secondary);"></i> 14 de junio 2026
        </div>
