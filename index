                    html += '<tr>' +
                        '<td>' + (g.Categoría || '-') + '</td>' +
                        '<td>' + (g.Concepto || '-') + '</td>' +
                        '<td>' + (g.Proveedor || '-') + '</td>' +
                        '<td><strong>$' + (parseFloat(g.Importe) || 0).toLocaleString() + '</strong></td>' +
                        '<td>' + (g.Fecha || '-') + '</td>' +
                        '<td><span class="status-badge ' + pagado + '">' + pagadoText + '</span></td>' +
                        '<td>' +
                        '<button class="btn-icon" onclick="editarFila(\'gastos\', \'' + g.ID + '\')"><i class="fas fa-edit"></i></button>' +
                        '<button class="btn-icon" onclick="eliminarFila(\'gastos\', \'' + g.ID + '\')"><i class="fas fa-trash"></i></button>' +
                        '</td>' +
                        '</tr>';
                }
            }
            document.getElementById('tablaGastos').innerHTML = html;
        }

        function aplicarFiltrosGastos() {
            actualizarTablaGastos();
        }

        // ============================================================
        // ACTUALIZAR SALONES
        // ============================================================
        async function actualizarSalones() {
            var raw = await obtenerDatos(RANGOS.salones);
            salonesCache = procesarDatos(raw);
            document.getElementById('totalSalones').textContent = salonesCache.length;

            var html = '';
            if (salonesCache.length === 0) {
                html = '<p style="color: var(--text-light);">No hay salones registrados</p>';
            } else {
                for (var i = 0; i < salonesCache.length; i++) {
                    var s = salonesCache[i];
                    var incluye = s.Incluye || 'No especificado';
                    html += '<div class="venue-card">' +
                        '<h3>' + (s.Nombre || 'Sin nombre') + '</h3>' +
                        '<div class="venue-detail"><i class="fas fa-map-pin"></i> ' + (s.Dirección || 'Sin dirección') + '</div>' +
                        '<div class="venue-detail"><i class="fas fa-users"></i> Aforo: ' + (s.Aforo || '0') + ' personas</div>' +
                        '<div class="venue-detail"><i class="fas fa-check-circle"></i> ' + incluye + '</div>' +
                        '<div class="venue-price">$' + (parseFloat(s.Precio) || 0).toLocaleString() + '</div>' +
                        '<div style="display: flex; gap: 10px;">' +
                        '<button class="btn-primary" style="padding: 6px 18px; font-size: 13px;" onclick="editarFila(\'salones\', \'' + s.ID + '\')"><i class="fas fa-edit"></i> Editar</button>' +
                        '<button class="btn-secondary" style="padding: 6px 18px; font-size: 13px;" onclick="eliminarFila(\'salones\', \'' + s.ID + '\')"><i class="fas fa-trash"></i> Eliminar</button>' +
                        '</div>' +
                        '</div>';
                }
            }
            document.getElementById('gridSalones').innerHTML = html;
        }

        // ============================================================
        // ACTUALIZAR MENÚS
        // ============================================================
        async function actualizarMenus() {
            var raw = await obtenerDatos(RANGOS.menus);
            menusCache = procesarDatos(raw);
            document.getElementById('totalMenus').textContent = menusCache.length;

            var iconos = ['🥩', '🥗', '🧒', '🍝', '🐟', '🌮'];
            var html = '';
            if (menusCache.length === 0) {
                html = '<p style="color: var(--text-light);">No hay menús registrados</p>';
            } else {
                for (var i = 0; i < menusCache.length; i++) {
                    var m = menusCache[i];
                    html += '<div class="menu-card">' +
                        '<div class="menu-icon">' + iconos[i % iconos.length] + '</div>' +
                        '<h3>' + (m.Nombre || 'Sin nombre') + '</h3>' +
                        '<div class="menu-price">$' + (parseFloat(m.PrecioPersona) || 0) + ' / persona</div>' +
                        '<div class="menu-desc">' + (m.Descripción || 'Sin descripción') + '</div>' +
                        '<button class="btn-primary" style="padding: 6px 18px; font-size: 13px; margin-top: 10px;" onclick="editarFila(\'menus\', \'' + m.ID + '\')">' +
                        '<i class="fas fa-edit"></i> Editar' +
                        '</button>' +
                        '</div>';
                }
            }
            document.getElementById('gridMenus').innerHTML = html;
        }

        // ============================================================
        // ACTUALIZAR TAREAS
        // ============================================================
        function actualizarTareas() {
            document.getElementById('totalTareas').textContent = tareasCache.length;

            var html = '';
            if (tareasCache.length === 0) {
                html = '<li style="color: var(--text-light);">No hay tareas registradas</li>';
            } else {
                for (var i = 0; i < tareasCache.length; i++) {
                    var t = tareasCache[i];
                    var completada = (t.Completada && t.Completada.toLowerCase() === 'sí');
                    var prioridadClass = 'priority-low';
                    if (t.Prioridad && t.Prioridad.toLowerCase() === 'alta') prioridadClass = 'priority-high';
                    else if (t.Prioridad && t.Prioridad.toLowerCase() === 'media') prioridadClass = 'priority-medium';
                    html += '<li>' +
                        '<input type="checkbox" ' + (completada ? 'checked' : '') + ' onchange="toggleTareaCompleta(this, \'' + t.Título + '\')">' +
                        '<span class="task-text ' + (completada ? 'done' : '') + '">' + (t.Título || 'Sin título') + '</span>' +
                        '<span class="task-date">' + (t.FechaLimite || '') + '</span>' +
                        '<span class="task-priority ' + prioridadClass + '">' + (t.Prioridad || 'Media') + '</span>' +
                        '<button class="btn-icon" onclick="editarFila(\'tareas\', \'' + t.ID + '\')"><i class="fas fa-edit"></i></button>' +
                        '<button class="btn-icon" onclick="eliminarFila(\'tareas\', \'' + t.ID + '\')"><i class="fas fa-trash"></i></button>' +
                        '</li>';
                }
            }
            document.getElementById('listaTareasCompleta').innerHTML = html;
        }

        // ============================================================
        // ACTUALIZAR PROVEEDORES
        // ============================================================
        async function actualizarProveedores() {
            var raw = await obtenerDatos(RANGOS.proveedores);
            proveedoresCache = procesarDatos(raw);
            document.getElementById('totalProveedores').textContent = proveedoresCache.length;

            var html = '';
            if (proveedoresCache.length === 0) {
                html = '<p style="color: var(--text-light);">No hay proveedores registrados</p>';
            } else {
                for (var i = 0; i < proveedoresCache.length; i++) {
                    var p = proveedoresCache[i];
                    var contratado = 'status-not-hired';
                    var contratadoText = ' Pendiente';
                    if (p.Contratado && p.Contratado.toLowerCase() === 'sí') {
                        contratado = 'status-hired';
                        contratadoText = ' Contratado';
                    }
                    html += '<div class="provider-card">' +
                        '<h3>' + (p.Nombre || 'Sin nombre') + '</h3>' +
                        '<div class="provider-detail"><i class="fas fa-tag"></i> Servicio: ' + (p.Servicio || '-') + '</div>' +
                        '<div class="provider-detail"><i class="fas fa-phone"></i> ' + (p.Teléfono || '-') + '</div>' +
                        '<div class="provider-detail"><i class="fas fa-envelope"></i> ' + (p.Email || '-') + '</div>' +
                        '<div class="provider-detail"><i class="fas fa-dollar-sign"></i> Presupuesto: $' + (parseFloat(p.Presupuesto) || 0).toLocaleString() + '</div>' +
                        '<div style="margin: 10px 0;">' +
                        '<span class="status-badge ' + contratado + '">' + contratadoText + '</span>' +
                        '</div>' +
                        '<div style="display: flex; gap: 10px;">' +
                        '<button class="btn-primary" style="padding: 6px 18px; font-size: 13px;" onclick="editarFila(\'proveedores\', \'' + p.ID + '\')"><i class="fas fa-edit"></i> Editar</button>' +
                        '<button class="btn-secondary" style="padding: 6px 18px; font-size: 13px;" onclick="eliminarFila(\'proveedores\', \'' + p.ID + '\')"><i class="fas fa-trash"></i> Eliminar</button>' +
                        '</div>' +
                        '</div>';
                }
            }
            document.getElementById('gridProveedores').innerHTML = html;
        }

        // ============================================================
        // FUNCIONES PARA TAREAS (toggle)
        // ============================================================
        async function toggleTarea(checkbox, titulo) {
            var tarea = null;
            for (var i = 0; i < tareasCache.length; i++) {
                if (tareasCache[i].Título === titulo) {
                    tarea = tareasCache[i];
                    break;
                }
            }
            if (!tarea) return;
            
            var nuevoEstado = checkbox.checked ? 'Sí' : 'No';
            var fila = 0;
            for (var j = 0; j < tareasCache.length; j++) {
                if (tareasCache[j].Título === titulo) {
                    fila = j + 2;
                    break;
                }
            }
            var rango = 'Tareas!E' + fila;
            
            await escribirDatos(rango, [[nuevoEstado]]);
            await actualizarDashboard();
        }

        async function toggleTareaCompleta(checkbox, titulo) {
            await toggleTarea(checkbox, titulo);
        }

        // ============================================================
        // FUNCIONES CRUD (Crear)
        // ============================================================
        function agregarInvitado() {
            var nombre = prompt('Nombre del invitado:');
            if (!nombre) return;
            var grupo = prompt('Grupo (Familia/Amigos/Trabajo):') || 'Otros';
            var email = prompt('Email:') || '';
            var telefono = prompt('Teléfono:') || '';
            var confirmado = confirm('Ya confirmó asistencia?') ? 'Sí' : 'No';
            var acompanantes = prompt('Número de acompañantes:') || '0';
            var dieta = prompt('Dieta especial (opcional):') || 'Ninguna';

            var nuevosDatos = [[
                invitadosCache.length + 1,
                nombre,
                grupo,
                email,
                telefono,
                confirmado,
                acompanantes,
                dieta,
                ''
            ]];
            escribirDatos(RANGOS.invitados, nuevosDatos).then(function() { actualizarDashboard(); });
        }

        function agregarGasto() {
            var categoria = prompt('Categoría (Catering/Salón/Fotografía/Música/Otros):');
            if (!categoria) return;
            var concepto = prompt('Concepto:');
            if (!concepto) return;
            var proveedor = prompt('Proveedor:') || '';
            var importe = prompt('Importe ($):');
            if (!importe || isNaN(importe)) return;
            var fecha = prompt('Fecha (YYYY-MM-DD):') || new Date().toISOString().split('T')[0];
            var pagado = confirm('Ya está pagado?') ? 'Sí' : 'No';

            var nuevosDatos = [[
                gastosCache.length + 1,
                categoria,
                concepto,
                proveedor,
                parseFloat(importe),
                fecha,
                pagado,
                ''
            ]];
            escribirDatos(RANGOS.gastos, nuevosDatos).then(function() { actualizarDashboard(); });
        }

        function agregarSalon() {
            var nombre = prompt('Nombre del salón:');
            if (!nombre) return;
            var direccion = prompt('Dirección:') || '';
            var aforo = prompt('Aforo máximo:') || '0';
            var precio = prompt('Precio ($):');
            if (!precio || isNaN(precio)) return;
            var fechas = prompt('Fechas disponibles:') || '';
            var incluye = prompt('Qué incluye? (ej: mesas, sillas, mantelería):') || '';

            var nuevosDatos = [[
                salonesCache.length + 1,
                nombre,
                direccion,
                parseInt(aforo),
                parseFloat(precio),
                fechas,
                incluye,
                ''
            ]];
            escribirDatos(RANGOS.salones, nuevosDatos).then(function() { actualizarDashboard(); });
        }

        function agregarMenu() {
            var nombre = prompt('Nombre del menú:');
            if (!nombre) return;
            var precio = prompt('Precio por persona ($):');
            if (!precio || isNaN(precio)) return;
            var descripcion = prompt('Descripción:') || '';

            var nuevosDatos = [[
                menusCache.length + 1,
                nombre,
                parseFloat(precio),
                descripcion
            ]];
            escribirDatos(RANGOS.menus, nuevosDatos).then(function() { actualizarDashboard(); });
        }

        function agregarTarea() {
            var titulo = prompt('Título de la tarea:');
            if (!titulo) return;
            var fecha = prompt('Fecha límite (YYYY-MM-DD):') || '';
            var prioridad = prompt('Prioridad (Alta/Media/Baja):') || 'Media';

            var nuevosDatos = [[
                tareasCache.length + 1,
                titulo,
                fecha,
                'No',
                prioridad
            ]];
            escribirDatos(RANGOS.tareas, nuevosDatos).then(function() { actualizarDashboard(); });
        }

        function agregarProveedor() {
            var nombre = prompt('Nombre del proveedor:');
            if (!nombre) return;
            var servicio = prompt('Servicio que ofrece:') || '';
            var telefono = prompt('Teléfono:') || '';
            var email = prompt('Email:') || '';
            var contratado = confirm('Ya está contratado?') ? 'Sí' : 'No';
            var presupuesto = prompt('Presupuesto ($):');
            if (!presupuesto || isNaN(presupuesto)) return;

            var nuevosDatos = [[
                proveedoresCache.length + 1,
                nombre,
                servicio,
                telefono,
                email,
                contratado,
                parseFloat(presupuesto)
            ]];
            escribirDatos(RANGOS.proveedores, nuevosDatos).then(function() { actualizarDashboard(); });
        }

        function editarFila(tabla, id) {
            alert('Funcionalidad de edición para ' + tabla + ' ID: ' + id + '\n(Próximamente implementada)');
        }

        function eliminarFila(tabla, id) {
            if (!confirm('Eliminar registro ID: ' + id + ' de ' + tabla + '?')) return;
            alert('Eliminar ' + tabla + ' ID: ' + id + '\n(Próximamente implementada)');
        }

        // ============================================================
        // MODO OSCURO
        // ============================================================
        var themeToggle = document.getElementById('themeToggle');
        var htmlRoot = document.getElementById('html-root');
        var savedTheme = localStorage.getItem('theme');
        if (savedTheme) htmlRoot.setAttribute('data-theme', savedTheme);
        themeToggle.addEventListener('click', function() {
            var currentTheme = htmlRoot.getAttribute('data-theme');
            var newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            htmlRoot.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
        });

        // ============================================================
        // MENÚ HAMBURGUESA
        // ============================================================
        var hamburgerBtn = document.getElementById('hamburgerBtn');
        var sidebar = document.getElementById('sidebar');
        var overlay = document.getElementById('sidebarOverlay');

        function toggleSidebar() {
            sidebar.classList.toggle('open');
            overlay.classList.toggle('active');
            var icon = hamburgerBtn.querySelector('i');
            icon.className = sidebar.classList.contains('open') ? 'fas fa-times' : 'fas fa-bars';
        }
        hamburgerBtn.addEventListener('click', toggleSidebar);
        overlay.addEventListener('click', toggleSidebar);

        // ============================================================
        // NAVEGACIÓN ENTRE SECCIONES
        // ============================================================
        var navLinks = document.querySelectorAll('.nav-menu a[data-section]');
        var sections = {
            dashboard: document.getElementById('section-dashboard'),
            invitados: document.getElementById('section-invitados'),
            gastos: document.getElementById('section-gastos'),
            salones: document.getElementById('section-salones'),
            menus: document.getElementById('section-menus'),
            tareas: document.getElementById('section-tareas'),
            proveedores: document.getElementById('section-proveedores')
        };

        for (var i = 0; i < navLinks.length; i++) {
            navLinks[i].addEventListener('click', function(e) {
                if (this.closest('.theme-toggle-wrapper')) return;
                var sectionName = this.dataset.section;
                if (window.innerWidth <= 768) toggleSidebar();
                for (var j = 0; j < navLinks.length; j++) {
                    navLinks[j].classList.remove('active');
                }
                this.classList.add('active');
                for (var key in sections) {
                    sections[key].classList.remove('active');
                }
                if (sections[sectionName]) sections[sectionName].classList.add('active');
            });
        }

        // ============================================================
        // INICIALIZAR
        // ============================================================
        window.addEventListener('load', function() {
            actualizarDashboard();
        });

        window.addEventListener('resize', function() {
            if (window.innerWidth > 768 && sidebar.classList.contains('open')) {
                sidebar.classList.remove('open');
                overlay.classList.remove('active');
                var icon = hamburgerBtn.querySelector('i');
                icon.className = 'fas fa-bars';
            }
        });
    </script>

</body>
</html>
