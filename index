                }
                filtrados = temp;
            }
            if (confirmadoFiltro !== 'todos') {
                var temp2 = [];
                for (var l = 0; l < filtrados.length; l++) {
                    if ((filtrados[l].Confirmado || '').toLowerCase() === confirmadoFiltro.toLowerCase()) temp2.push(filtrados[l]);
                }
                filtrados = temp2;
            }
            if (busqueda) {
                var temp3 = [];
                for (var m = 0; m < filtrados.length; m++) {
                    if ((filtrados[m].Nombre || '').toLowerCase().includes(busqueda)) temp3.push(filtrados[m]);
                }
                filtrados = temp3;
            }

            var html = '';
            if (filtrados.length === 0) {
                html = '<tr><td colspan="8" style="text-align: center; color: var(--text-light);">No hay invitados que coincidan</td></tr>';
            } else {
                for (var n = 0; n < filtrados.length; n++) {
                    var i = filtrados[n];
                    var confirmado = 'status-pending';
                    var confirmadoText = ' Pendiente';
                    if (i.Confirmado && i.Confirmado.toLowerCase() === 'sí') {
                        confirmado = 'status-confirmed';
                        confirmadoText = ' Confirmado';
                    }
                    html += '<tr>' +
                        '<td><strong>' + (i.Nombre || 'Sin nombre') + '</strong></td>' +
                        '<td>' + (i.Grupo || '-') + '</td>' +
                        '<td>' + (i.Email || '-') + '</td>' +
                        '<td>' + (i.Teléfono || '-') + '</td>' +
                        '<td><span class="status-badge ' + confirmado + '">' + confirmadoText + '</span></td>' +
                        '<td>' + (i.Acompañantes || '0') + '</td>' +
                        '<td>' + (i.Dieta || 'Ninguna') + '</td>' +
                        '<td>' +
                        '<button class="btn-icon" onclick="editarFila(\'invitados\', \'' + i.ID + '\')"><i class="fas fa-edit"></i></button>' +
                        '<button class="btn-icon" onclick="eliminarFila(\'invitados\', \'' + i.ID + '\')"><i class="fas fa-trash"></i></button>' +
                        '</td>' +
                        '</tr>';
                }
            }
            document.getElementById('tablaInvitadosCompleta').innerHTML = html;
        }

